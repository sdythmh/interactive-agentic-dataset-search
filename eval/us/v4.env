# Retrieval switches of the evaluated system, us corpus. The same values as
# eval/v4.env except CORPUS; INDEX_NAME is not set, so corpora/us/corpus.py
# supplies it (an INDEX_NAME left over from the au file would search the wrong
# index; retrieval.py checks the index's corpus before the first search).

CORPUS=us

USE_EN_SUBFIELDS=1

RERANK_MODE=vote
RERANK_VOICES=cross,graph
VOTE_ABSENT_RANK=none

DEDUP_BY_TITLE=1
HYDRATE_CANDIDATES=1
GRAPH_ORG_MATCH=family
GRAPH_MEMBER_ORDER=query

EMBED_QUERY_PREFIX=1
