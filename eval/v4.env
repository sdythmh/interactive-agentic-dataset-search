# Retrieval switches of the evaluated system, au corpus (data.gov.au).
# Loaded by ui/run_ui.sh and eval/run_clear.sh; ui/selfcheck.py checks that a
# worker runs with exactly these values. The uk and us files differ only in
# CORPUS and in leaving INDEX_NAME to the corpus default.

CORPUS=au

INDEX_NAME=knowledge-elements-v3
USE_EN_SUBFIELDS=1

RERANK_MODE=vote
RERANK_VOICES=cross,graph
VOTE_ABSENT_RANK=none

DEDUP_BY_TITLE=1
EMBED_QUERY_PREFIX=1

HYDRATE_CANDIDATES=1
GRAPH_ORG_MATCH=family
GRAPH_MEMBER_ORDER=query
